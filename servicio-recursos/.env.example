# Copie este archivo como .env solo para pruebas locales. En Vercel se
# configuran las mismas variables en Settings > Environment Variables.

# Cadena del Transaction pooler de Supabase (puerto 6543) terminada en ?sslmode=require
DATABASE_URL=postgresql://usuario:clave@host:6543/postgres?sslmode=require

# La MISMA llave que usa el servicio de Identidad para firmar los tokens.
JWT_SECRETO=pegue-aqui-una-llave-larga-y-aleatoria

# La MISMA clave de servicio que tienen Asistencia y Personas.
CLAVE_SERVICIO=pegue-aqui-la-clave-de-servicio

# Dirección del servicio de Asistencia, sin barra al final.
ASISTENCIA_URL=https://su-asistencia.vercel.app

# Dirección del servicio de Alertas (Render). Si se deja vacía, no se publican eventos.
ALERTAS_URL=
